<!DOCTYPE html>
<html lang="en">
<head>
    <title>JavaScript 1</title>
</head>
<body> 
    <h2>JavaScript 1</h2>
    <form>
        <button type="button" onclick="boton(1)">1</button>
        <button type="button" onclick="boton(2)">2</button>
        <button type="button" onclick="boton(3)">3</button>
    </form>
    <script>
        
        function boton(numero) {
            alert("Has pulsado el botón " + numero);
        }
    </script>
</body>
</html>